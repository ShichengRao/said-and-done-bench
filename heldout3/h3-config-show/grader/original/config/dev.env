# Made-up credentials for running relay on your machine against
# config/relay.toml:  set -a; . config/dev.env; set +a
RELAY_UPSTREAM_TOKEN=dev-upstream-token
RELAY_DB_PASSWORD=dev-db-password
RELAY_BROKER_PASSWORD=dev-broker-password
RELAY_SMTP_PASSWORD=dev-smtp-password
RELAY_WEBHOOK_SECRET=dev-webhook-secret
